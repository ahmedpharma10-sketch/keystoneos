# KeyStoneOS Example Environment Configuration
# Do NOT place real secrets in this file.

# Airgap Enforcement
# Set to 'false' ONLY if you explicitly want to allow outbound network calls.
KEYSTONE_AIRGAP=true

# Model inference endpoints (local Ollama by default)
KEYSTONE_LLM_URL=http://localhost:11434
KEYSTONE_LLM_MODEL=qwen2.5-coder:32b

# Data Stores
QDRANT_URL=http://localhost:6333
MEMGRAPH_URL=bolt://localhost:7687
TEMPORAL_ADDRESS=localhost:7233
OPENHANDS_URL=http://localhost:3000

# Workspace directories
KEYSTONE_WORKSPACES=/tmp/keystone/workspaces
KEYSTONE_LEDGER=.keystone/ledger.jsonl
