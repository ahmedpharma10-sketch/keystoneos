{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyStoneOS",
  "version": "0.1.0",
  "identifier": "com.evoiq.keystoneos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "KeyStoneOS", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
